// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// PostgreSQL (Render). Set DATABASE_URL, e.g. the Render Postgres "Internal Database URL".
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

/// Fast index of reviews. The source of truth is the `vw_review` metaobject in Shopify;
/// this table can always be rebuilt from Shopify with "Resync".
model Review {
  id        String   @id            // metaobject GID
  shop      String
  productId String                  // numeric product id
  rating    Int
  title     String?
  body      String
  author    String
  location  String?
  status    String                  // pending | published | hidden
  verified  Boolean  @default(false)
  source    String   @default("Website")
  orderId   String?
  images    String   @default("[]") // JSON: [{ id, url, alt }]
  avatar    String?                 // JSON: { id, url } reviewer picture
  replies   String   @default("[]") // JSON: [{ id, author, text, isStore, createdAt }]
  helpful   Int      @default(0)
  featured  Boolean  @default(false)
  banner    Boolean  @default(false) // shown in the "What our customers say" banner
  customerId String?                // shopper who wrote it in the store (for blocking)
  hasMedia  Boolean  @default(false)
  needsReply    Boolean   @default(false) // a comment thread ends with a customer message
  commentCount  Int       @default(0)
  lastCommentAt DateTime?                // latest customer comment/reply
  createdAt DateTime
  updatedAt DateTime @updatedAt

  @@index([shop, productId, status, createdAt])
  @@index([shop, productId, status, rating])
  @@index([shop, status])
  @@index([shop, needsReply])
}

/// Who marked what as helpful / liked (one vote per customer per target).
model Vote {
  id         String   @id @default(cuid())
  shop       String
  reviewId   String                 // metaobject GID of the review
  targetId   String                 // review id, comment id or reply id
  customerId String
  kind       String                 // "helpful" (review) | "like" (comment/reply)
  createdAt  DateTime @default(now())

  @@unique([targetId, customerId, kind])
  @@index([reviewId])
}
